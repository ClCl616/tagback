# Optional: copy these non-secret settings into the repository root .env.
TAGBACK_HTTPS_PORT=8443
TAGBACK_TLS_DIR=./deploy/compose/local/tls
NFC_BRIDGE_ID=kiosk-1
TAGBACK_API_IMAGE=tagback-api:local
TAGBACK_WEB_IMAGE=tagback-web:local

# Non-secret OAuth settings; register this exact HTTPS URI in Kakao Developers.
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://localhost:8443/api/v1/auth/kakao/callback
# Store client secret in deploy/compose/local/kakao-client-secret (never commit).
