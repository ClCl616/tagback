{
  "name": "tagback-kiosk",
  "productName": "TagBackKiosk",
  "version": "0.1.2",
  "private": true,
  "description": "TagBack Windows kiosk trial host",
  "author": "TagBack",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:resources": "node scripts/prepare.cjs",
    "start": "node node_modules/electron/install.js && electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "package": "npm run prepare:resources && electron-forge package --platform=win32 --arch=x64",
    "make": "npm run prepare:resources && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": { "electron-squirrel-startup": "1.0.1" },
  "devDependencies": {
    "electron": "45.3.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1"
  }
}
